# The build context is the REPO ROOT, so a Dockerfile can COPY from both
# toolbelt/ and docker/.
#
# Exclude a path only if no COPY needs it AND copying it would be wrong
# (host-built artifacts, VCS metadata). Excluding merely-unused trees buys
# nothing: a COPY layer is invalidated by the files it copies, not by the size
# of the context.

# The largest thing in the context, and no build step reads it.
.git

# oxlint/oxfmt are a package.json + lockfile and a baseline config; the tree
# they describe is installed INSIDE the image by install-dev-tools.sh
# (`npm ci`). A node_modules/ left there by someone running the toolchain from
# a checkout would otherwise be copied into the context — megabytes of
# host-built binaries that `npm ci` deletes on its first line anyway, and that
# carry the host's platform rather than the image's.
toolbelt/oxlint/node_modules
toolbelt/oxfmt/node_modules

# Same story for the phpstan extension: composer installs it inside the image
# from this path repo, so a vendor/ tree a local test run left behind is the
# host's, not the image's.
toolbelt/phpstan/vendor
toolbelt/phpstan/composer.lock
packages/civikitchen-scenario-schema/vendor

# Host-built artifacts from running the tool test suites, or from re-locking a
# tool root, out of a checkout. The composer.lock files next to them are the
# opposite: they MUST reach the image — they are what the installs read.
toolbelt/psalm/vendor
toolbelt/rector/vendor
toolbelt/phpstan-root/vendor
toolbelt/phpcs-root/vendor
toolbelt/ckconform/.phpunit.result.cache
toolbelt/phpstan/.phpunit.result.cache
node_modules
