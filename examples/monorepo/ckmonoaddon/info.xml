<?xml version="1.0"?>
<extension key="de.civico.ckmonoaddon" type="module">
  <file>ckmonoaddon</file>
  <name>CK Mono Addon</name>
  <description>Example extension: requires ckmonobase out of the same repository.</description>
  <license>AGPL-3.0-or-later</license>
  <maintainer>
    <author>civico GmbH</author>
    <email>hi@example.org</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://example.org/ckmonoaddon</url>
  </urls>
  <releaseDate>2026-01-01</releaseDate>
  <version>1.0.0</version>
  <develStage>stable</develStage>
  <compatibility>
    <ver>6.0</ver>
  </compatibility>
  <requires>
    <ext>de.civico.ckmonobase</ext>
  </requires>
  <classloader>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <civix>
    <namespace>CRM/Ckmonoaddon</namespace>
    <format>25.10.2</format>
  </civix>
</extension>
