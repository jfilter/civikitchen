#!/bin/bash
#
# ckeslint — JS/TS lint gate for CiviCRM extensions, with the CiviKitchen
# baseline config, or the project's own .oxlintrc.json when it ships one.
#
# The JS counterpart to cklint, and built the same way round: the toolchain and
# the default ruleset live in the IMAGE (pinned, installed once at build time),
# not in a dozen package.json files that would each drift and each need a
# dependabot PR. A repo that wants its own rules writes an .oxlintrc.json and
# this tool steps out of the way entirely.
#
# The engine is oxlint (plus oxlint-tsgolint for the type-aware rules and the
# eslint-plugin-no-unsanitized JS plugin). The name and the CLI contract are
# unchanged on purpose: the fleet's CI calls `ckeslint`.
#
# What the baseline gates and why is in the config itself
# (/opt/civikitchen-oxlint/.oxlintrc.json) — short version: real mistakes
# (oxlint's `correctness` category), unsafe DOM sinks (Mozilla's
# no-unsanitized), and type-aware promise/any handling on TS when the repo has
# a tsconfig.json.
#
# No JS in the repo is a PASS, loudly: most CiviCRM extensions are PHP with a
# couple of Angular files or none at all, and an unconditional CI step has to
# say "nothing to lint" rather than fail on a missing target or, worse, exit 0
# without saying anything.
#
set -euo pipefail

usage() {
  cat <<'EOF'
ckeslint — JS/TS lint gate for CiviCRM extensions (CiviKitchen baseline, oxlint).

  ckeslint              lint the project's JS/TS
  ckeslint --fix        apply the fixes oxlint can apply, then report the rest
  ckeslint path ...     lint the given files/dirs instead of the whole project
  ckeslint --format=X   oxlint's reporter (unix, github, json, sarif, ...). The
                        default reporter varies with the terminal, so anything
                        parsing the output should pin one.

The project's own .oxlintrc.json wins when present; otherwise the bundled
CiviKitchen baseline applies. Run from the extension root.
EOF
}

fix=0
format=()
paths=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --fix)     fix=1 ;;
    --format=*) format=(--format="${1#--format=}") ;;
    --format)  shift; format=(--format="${1:-}") ;;
    -h|--help) usage; exit 0 ;;
    --)        shift; break ;;
    -*)        echo "ckeslint: unknown option: $1" >&2; usage >&2; exit 2 ;;
    *)         paths+=("$1") ;;
  esac
  shift
done
while [ "$#" -gt 0 ]; do paths+=("$1"); shift; done

[ -f info.xml ] || { echo "ckeslint: no info.xml here — run from the extension root." >&2; exit 2; }

toolchain=/opt/civikitchen-oxlint
if [ ! -x "$toolchain/node_modules/.bin/oxlint" ]; then
  # Running out of a civikitchen checkout (developing the tool itself) rather
  # than from the image that installs the toolchain.
  candidate="$(cd "$(dirname "${BASH_SOURCE[0]}")/oxlint" 2>/dev/null && pwd)" || candidate=""
  if [ -n "$candidate" ] && [ -x "$candidate/node_modules/.bin/oxlint" ]; then
    toolchain="$candidate"
  else
    echo "ckeslint: no oxlint toolchain at /opt/civikitchen-oxlint — is this a civikitchen image?" >&2
    exit 2
  fi
fi

# Is there anything to lint at all? The same exclusions the gate ignores,
# applied here too: a repo whose only JS is a vendored minified bundle has no
# JS worth a gate, and finding that out from `git ls-files` costs milliseconds.
#
# git ls-files, not find: a build tree or a stray node_modules/ in a developer's
# checkout is not this repo's code, and the file list that matters is the one
# that is committed.
if [ "${#paths[@]}" -eq 0 ]; then
  # `|| true` on the grep chain, not decoration: grep exits 1 when it filters
  # everything away, and under `pipefail` that would abort the script on the
  # exact case this block exists to detect — a repo with no JS at all.
  # safe.directory per call, same as ckconform: under CI's uid mismatch
  # (runner-owned checkout, www-data process) git calls the tree dubious and
  # ls-files reports NOTHING — which this check would misread as "no JS".
  count=$({ git -c safe.directory="$PWD" ls-files -- '*.js' '*.mjs' '*.cjs' '*.ts' '*.tsx' 2>/dev/null \
    | grep -Ev '(^|/)(node_modules|vendor|dist|build|bower_components|packages|\.civikitchen-siblings)/' \
    | grep -Ev '\.(min|bundle)\.(js|ts)$' || true; } | wc -l | tr -d ' ')
  if [ "$count" = 0 ]; then
    echo "ckeslint: no JavaScript or TypeScript in this repo — nothing to lint."
    exit 0
  fi
  echo "ckeslint: $count JS/TS file(s) to lint."
  paths=(.)
fi

args=()
[ "$fix" -eq 1 ] && args+=(--fix)
args+=(${format[@]+"${format[@]}"})

if [ -f .oxlintrc.json ]; then
  # A repo that owns its config owns its jsPlugins too: oxlint resolves those
  # against the config file's directory, so a `jsPlugins` entry there means the
  # repo's node_modules, not the toolchain's. In CI that means the repo also
  # turns `npm_ci` on. oxlint's own discovery finds it — no -c needed.
  echo "ckeslint: using this repo's own .oxlintrc.json (the CiviKitchen baseline does not apply; any jsPlugins it names must be installed in this repo's node_modules)."
elif compgen -G 'eslint.config.*' > /dev/null; then
  # Loud stop, not a silent skip: the image no longer ships ESLint, so an
  # untranslated repo config would leave the gate running rules nobody chose.
  echo "ckeslint: this repo ships an eslint.config.* but the image gate is oxlint now — add an .oxlintrc.json or remove the custom config." >&2
  exit 2
else
  # Type-aware rules need a real TypeScript program; without a root tsconfig
  # every import is `any` and no-unsafe-* buries the gate in false positives.
  if [ -f tsconfig.json ]; then
    args+=(-c "$toolchain/.oxlintrc.json")
  else
    args+=(-c "$toolchain/.oxlintrc-no-type-aware.json")
  fi
  # ignorePatterns inside a config are rooted at THAT config's directory, so
  # the baseline cannot carry them from /opt — they have to arrive as flags,
  # which resolve against the working directory instead.
  args+=(
    --ignore-pattern '**/node_modules/**'
    --ignore-pattern '**/vendor/**'
    --ignore-pattern '**/dist/**'
    --ignore-pattern '**/build/**'
    --ignore-pattern '**/.civikitchen-siblings/**'
    --ignore-pattern '**/bower_components/**'
    --ignore-pattern '**/packages/**'
    --ignore-pattern '**/*.min.js'
    --ignore-pattern '**/*.bundle.js'
  )
fi

# oxlint resolves the tsgolint binary by Node resolution from the PROJECT, and
# the project has no node_modules — so point it at the toolchain's copy. The
# npm package ships one platform-specific subpackage; glob rather than name it.
if [ -z "${OXLINT_TSGOLINT_PATH:-}" ]; then
  for c in "$toolchain"/node_modules/@oxlint-tsgolint/*/tsgolint; do
    [ -x "$c" ] && { export OXLINT_TSGOLINT_PATH="$c"; break; }
  done
fi

# Node globals (process.env, __dirname) in e2e suites: tsgolint builds its
# TypeScript program from the REPO, so `process` is an error type unless
# @types/node resolves there — and every expression touching it then trips
# no-unsafe-*. The image carries the types so no repo has to install them;
# they are linked in for the run only and removed again by the trap, because
# node_modules belongs to the repo, not to the gate. A repo that ships its own
# copy keeps it — two @types/node in one program is the conflict to avoid.
overlay_link=""
# shellcheck disable=SC2329,SC2317  # invoked via the EXIT/INT/TERM trap below
cleanup_overlay() {
  [ -n "${overlay_link}" ] || return 0
  rm -f "${overlay_link}"
  rmdir "$(dirname "${overlay_link}")" 2>/dev/null || true
  rmdir "$(dirname "$(dirname "${overlay_link}")")" 2>/dev/null || true
}
trap cleanup_overlay EXIT INT TERM
if [ -f tsconfig.json ] && [ ! -e node_modules/@types/node ] \
    && [ -d "$toolchain/node_modules/@types/node" ]; then
  if mkdir -p node_modules/@types 2>/dev/null \
      && ln -s "$toolchain/node_modules/@types/node" node_modules/@types/node 2>/dev/null; then
    overlay_link="$PWD/node_modules/@types/node"
  fi
  # Resolvable is only half of it: tsgolint does not auto-include @types the
  # way tsc does, so the tsconfig has to name them. Said once, with the fix.
  if [ -n "${overlay_link}" ] && ! grep -q '"types"' tsconfig.json \
      && git -c safe.directory="$PWD" grep -qI -e 'process\.' -e '__dirname' -e '__filename' -- '*.ts' '*.tsx' >/dev/null 2>&1; then
    echo "ckeslint: this repo uses Node globals but its tsconfig.json has no \"types\" — add \"types\": [\"node\"], or the type-aware rules see an untyped \`process\`."
  fi
fi

# `${args[@]+...}`: an empty array under `set -u` is an unbound variable on
# bash 3.2 (macOS, where this tool is also developed).
# Not exec: the overlay cleanup trap has to run.
rc=0
"$toolchain/node_modules/.bin/oxlint" ${args[@]+"${args[@]}"} "${paths[@]}" || rc=$?
exit "$rc"
