{
    "name": "civikitchen/phpstan-ck-legacy",
    "type": "phpstan-extension",
    "description": "CiviKitchen PHPStan extension: @ck-legacy deprecated-scope resolver plus fleet-wide phpat architecture rules (extension boundary, legacy UI bases).",
    "license": "MIT",
    "version": "1.1.0",
    "require": {
        "php": ">=7.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpat/phpat": "^0.12"
    },
    "autoload": {
        "psr-4": {
            "CiviKitchen\\PHPStan\\": "src/"
        }
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    }
}
