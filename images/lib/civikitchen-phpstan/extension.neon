parameters:
	civikitchen:
		# `civicrm_`-prefixed tables of OTHER extensions this repo queries.
		# Core's tables and the repo's own schema are found automatically.
		sqlKnownTables: []
		# The generated xml/Menu route list (tools/gen-route-catalog.php).
		# Missing file = the GET-mutation rule only sees page classes.
		routeCatalog: %currentWorkingDirectory%/.ck-routes.json

parametersSchema:
	civikitchen: structure([
		sqlKnownTables: listOf(string())
		routeCatalog: string()
	])

services:
	-
		class: CiviKitchen\PHPStan\CkLegacyScopeResolver
		tags:
			- phpstan.deprecations.deprecatedScopeResolver
	# phpat discovers rule classes by this tag; without phpat installed the
	# service is simply never requested, so the package stays usable alone.
	-
		class: CiviKitchen\PHPStan\ArchitectureTest
		arguments:
			- %currentWorkingDirectory%
		tags:
			- phpat.test
	# The APIv4 contract rules share one analyser; the split into three
	# rules is only because a phpstan rule binds to a single node type.
	-
		class: CiviKitchen\PHPStan\Api4Contract
		arguments:
			- %currentWorkingDirectory%
	-
		class: CiviKitchen\PHPStan\Api4FunctionCallRule
		tags:
			- phpstan.rules.rule
	-
		class: CiviKitchen\PHPStan\Api4StaticCallRule
		tags:
			- phpstan.rules.rule
	-
		class: CiviKitchen\PHPStan\Api4FluentFieldRule
		tags:
			- phpstan.rules.rule
	# Custom APIv4 actions: parameter properties that would fail as PHP
	# errors rather than API validation errors.
	-
		class: CiviKitchen\PHPStan\Api4ActionPropertyRule
		tags:
			- phpstan.rules.rule
	# The counterpart that keeps checkUninitializedProperties usable: the
	# kernel writes those properties, no code in the extension does.
	-
		class: CiviKitchen\PHPStan\Api4ActionPropertiesExtension
		tags:
			- phpstan.properties.readWriteExtension
	-
		class: CiviKitchen\PHPStan\TransactionalTestDdlRule
		tags:
			- phpstan.rules.rule
	-
		class: CiviKitchen\PHPStan\NoSilentDatabaseCatchRule
		tags:
			- phpstan.rules.rule
	# Raw SQL against the generated table catalog. Split into two rules for
	# the same reason as the APIv4 ones: one node type per rule.
	-
		class: CiviKitchen\PHPStan\SqlSchema
		arguments:
			- %currentWorkingDirectory%
			- %civikitchen.sqlKnownTables%
	-
		class: CiviKitchen\PHPStan\SqlTableStaticCallRule
		tags:
			- phpstan.rules.rule
	-
		class: CiviKitchen\PHPStan\SqlTableMethodCallRule
		tags:
			- phpstan.rules.rule
	# GET must not write. The catalog says which static methods xml/Menu
	# hands a browser; page classes are found through their base class.
	-
		class: CiviKitchen\PHPStan\RouteCatalog
		arguments:
			- %civikitchen.routeCatalog%
	-
		class: CiviKitchen\PHPStan\GetMutationRule
		tags:
			- phpstan.rules.rule
