#!/bin/bash
#
# ckschemadiff — compare the schema an extension INSTALLS with the schema it
# UPGRADES to, over its own tables only.
#
# The bug this exists for: install() and the upgrade_NNNN() chain are two
# independent descriptions of the same schema, and nothing keeps them in step.
# A developer adds a column to schema/Foo.entityType.php (or xml/schema), writes
# the matching upgrader, and gets the column type subtly wrong in one of the two
# — NOT NULL in the installer, nullable in the upgrader; VARCHAR(64) here,
# VARCHAR(255) there; an index the installer creates and the upgrader forgets.
# Every fresh install is fine. Every upgraded site is quietly different, and
# stays different forever, because no later upgrader will ever reconcile them.
# The shared CI's `upgrade` job proves the upgrader RUNS; it says nothing about
# where it arrives.
#
# So: dump both, normalise, diff. Run inside the app container, where the mysql
# client and the database network live.
#
#   ckschemadiff tables                 the extension's own tables (from the checkout)
#   ckschemadiff dump <db> <outfile>    normalised DDL for those tables
#   ckschemadiff diff <fileA> <fileB>   unified diff; non-zero when they differ
#
# --- Why mysqldump and not Atlas -------------------------------------------
#
# Atlas (`atlas schema diff`) was the other candidate and is the better tool in
# the abstract — it produces a migration, not a text diff. It loses here on
# three concrete points in THIS setup, all of them about where things run:
#
#   * Reachability. The CI compose stack publishes no database port; `db` is
#     resolvable only from inside the compose network. Atlas would therefore
#     have to run in the app container, which is the CiviCRM image — so every
#     CI run pays a pinned binary download plus checksum verification, for a
#     container that already ships mysqldump (default-mysql-client, installed
#     in images/standalone/Dockerfile).
#   * Scope. `atlas schema diff` compares whole schemas. Both databases here
#     are full CiviCRM installs, so the diff would be dominated by core tables
#     — and core's own install-vs-upgrade differences are not this extension's
#     business. Restricting Atlas to a table set means building filtered
#     scratch schemas first, at which point mysqldump has already done the job.
#   * Determinism. mysqldump --no-data over an explicit, sorted table list is
#     byte-stable except for a handful of values that are documented noise
#     (AUTO_INCREMENT counter, the version banner). Those are normalised below,
#     each with its reason. That is a small enough surface to reason about.
#
# The trade is honest: this compares DDL TEXT, so it can report a difference
# that is semantically nil (two spellings of the same default). When that
# happens the fix is one more normalisation rule here, not a different tool.
#
set -euo pipefail

usage() {
  cat <<'EOF'
ckschemadiff — install-vs-upgrade schema parity for a CiviCRM extension.

  ckschemadiff tables               list the extension's own tables (from schema/ or xml/schema)
  ckschemadiff dump DB OUTFILE      normalised CREATE TABLE DDL for those tables
  ckschemadiff diff FILE_A FILE_B   unified diff of two dumps; exit 1 when they differ

Run `tables` and `dump` from the extension root, inside a civikitchen
container. Connection settings come from the usual CIVICRM_DB_* environment.
EOF
}

# ---------------------------------------------------------------------------
# The extension's own tables.
#
# Read from the repo's schema DECLARATIONS, not from the database: the point of
# the gate is to compare two databases, so neither of them can be the authority
# on which tables to look at. Both declaration formats are parsed with real
# parsers (PHP include / SimpleXML) rather than line tools — the lesson
# ckconform's shell-to-PHP rewrite is a monument to.
ck_tables() {
  [ -f info.xml ] || { echo "ckschemadiff: no info.xml here — run from the extension root." >&2; exit 2; }
  php -r '
    $tables = [];
    // schema/*.entityType.php: the modern declaration. Including it is safe —
    // every expensive part of the file is behind an arrow function (getFields,
    // getIndices), so nothing is evaluated but the outer array literal.
    foreach (glob("schema/*.entityType.php") ?: [] as $file) {
      try {
        $entity = include $file;
      }
      catch (\Throwable $e) {
        fwrite(STDERR, "ckschemadiff: cannot read $file: " . $e->getMessage() . "\n");
        exit(2);
      }
      if (is_array($entity) && !empty($entity["table"])) {
        $tables[] = $entity["table"];
      }
    }
    // xml/schema/**/*.xml: the civix/legacy declaration. <table><name> is the
    // table; the same file also carries <field><name>, hence the explicit path
    // rather than a search for any <name>.
    $it = is_dir("xml/schema")
      ? new RecursiveIteratorIterator(new RecursiveDirectoryIterator("xml/schema", FilesystemIterator::SKIP_DOTS))
      : [];
    foreach ($it as $file) {
      if (strtolower($file->getExtension()) !== "xml") {
        continue;
      }
      $xml = @simplexml_load_file($file->getPathname());
      if ($xml === FALSE) {
        continue;
      }
      if ($xml->getName() === "table" && (string) $xml->name !== "") {
        $tables[] = (string) $xml->name;
      }
      foreach ($xml->table ?? [] as $table) {
        if ((string) $table->name !== "") {
          $tables[] = (string) $table->name;
        }
      }
    }
    $tables = array_values(array_unique($tables));
    sort($tables);
    foreach ($tables as $table) {
      echo $table, "\n";
    }
  '
}

# ---------------------------------------------------------------------------
# Normalised DDL for one database.
#
# --compact --no-data --skip-add-drop-table strips everything but the CREATE
# TABLE statements. What is left and still varies between two dumps of two
# databases that ought to be identical:
#
#   * AUTO_INCREMENT=<n> — the next id counter. Two installs that inserted a
#     different number of rows differ here and are not different schemas. This
#     is THE reason a naive dump-and-diff of this pair is red on every run.
#   * /*!<version> ... */ conditional-execution wrappers around the per-table
#     charset save/restore. Same server on both sides, but they are noise
#     either way.
#   * trailing whitespace and blank-line runs.
#
# Table ORDER is not normalised because it is not a variable: the list is sorted
# before it reaches mysqldump, and mysqldump emits tables in the order given.
ck_dump() {
  local db="$1" out="$2"
  # while-read rather than mapfile: this tool is also run from a macOS checkout
  # while it is being worked on, and bash there is still 3.2.
  local tables=() line
  while IFS= read -r line; do
    [ -n "$line" ] && tables+=("$line")
  done < <(ck_tables)
  # Not a failure: the CI gate only greps for schema FILES, and a file that
  # declares no table of its own (helper/abstract XML) is legitimate. An empty
  # dump keeps the pipeline honest — two empty dumps compare equal downstream.
  if [ "${#tables[@]}" -eq 0 ]; then
    echo "ckschemadiff: this extension declares no tables of its own — writing an empty dump."
    : > "$out"
    return 0
  fi

  : "${CIVICRM_DB_HOST:=db}"
  : "${CIVICRM_DB_PORT:=3306}"
  : "${CIVICRM_DB_USER:=civicrm}"
  : "${CIVICRM_DB_PASSWORD:=civicrm}"

  # stderr passes through minus the password-on-CLI warning: a failing dump
  # (missing table, bad credentials) must say WHY, not just exit non-zero.
  mysqldump \
    -h "$CIVICRM_DB_HOST" -P "$CIVICRM_DB_PORT" \
    -u "$CIVICRM_DB_USER" -p"$CIVICRM_DB_PASSWORD" \
    --no-data --compact --skip-comments --skip-add-drop-table --skip-set-charset \
    "$db" "${tables[@]}" 2> >(grep -v 'Using a password on the command line' >&2) \
    | ck_normalize > "$out"

  [ -s "$out" ] || { echo "ckschemadiff: mysqldump produced nothing for $db (are the tables installed?)" >&2; exit 2; }
  echo "ckschemadiff: dumped ${#tables[@]} table(s) from $db to $out"
}

# The normalisation itself, factored out so it can be tested on its own against
# canned dumps without a database anywhere near it.
ck_normalize() {
  sed -e 's/ AUTO_INCREMENT=[0-9]*//g' \
      -e '/^\/\*!/d' \
      -e 's/[[:space:]]*$//' \
    | grep -v '^$' || true
}

ck_diff() {
  local a="$1" b="$2"
  [ -f "$a" ] || { echo "ckschemadiff: no such file: $a" >&2; exit 2; }
  [ -f "$b" ] || { echo "ckschemadiff: no such file: $b" >&2; exit 2; }
  if diff -u --label 'fresh install of HEAD' "$a" --label 'last release upgraded to HEAD' "$b"; then
    echo "ckschemadiff: schemas match — install() and the upgrader agree."
    return 0
  fi
  cat >&2 <<'EOF'

ckschemadiff: the two schemas differ.

A line only in "fresh install of HEAD" is something install() creates and no
upgrader adds: existing sites will never get it. A line only in "last release
upgraded to HEAD" is something an upgrader added that install() does not
create: new sites will never have it. Either way the fleet is running two
different schemas under one version number — fix whichever of the two
descriptions is behind.
EOF
  return 1
}

case "${1:-}" in
  tables)    shift; ck_tables ;;
  dump)      shift; [ "$#" -eq 2 ] || { usage >&2; exit 2; }; ck_dump "$1" "$2" ;;
  diff)      shift; [ "$#" -eq 2 ] || { usage >&2; exit 2; }; ck_diff "$1" "$2" ;;
  normalize) shift; ck_normalize ;;
  -h|--help) usage ;;
  *)         usage >&2; exit 2 ;;
esac
