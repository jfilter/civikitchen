{
    "name": "civikitchen/mago-ext",
    "description": "CiviKitchen checks as a mago extension: linter rules and analyzer plugins, sharing their contract logic with the phpstan extension.",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.1",
        "carthage-software/mago": "1.55.0"
    },
    "autoload": {
        "psr-4": {
            "CiviKitchen\\Mago\\": "src/",
            "CiviKitchen\\PHPStan\\": "../phpstan/src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.31"
        },
        "sort-packages": true
    }
}
