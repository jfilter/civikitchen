{
    "name": "civikitchen/phpcs-root",
    "description": "CiviKitchen phpcs installation root (the image's COMPOSER_HOME): phpcs as the engine of PHPCompatibility for ckcompat, and the dependency analyser behind ckdeps.",
    "license": "AGPL-3.0-or-later",
    "require": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1",
        "phpcompatibility/php-compatibility": "10.0.0-alpha2",
        "phpcsstandards/phpcsutils": "1.2.3",
        "shipmonk/composer-dependency-analyser": "1.8.4",
        "squizlabs/php_codesniffer": "^3.13.6"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.1.31"
        }
    }
}
