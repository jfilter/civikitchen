#!/bin/bash
#
# ckfmt — code formatting for CiviCRM extensions: mago fmt for PHP, oxfmt for
# JS/TS. The formatter counterpart to cklint/ckeslint, built the same way
# round: pinned toolchain and baseline config live in the IMAGE, a repo that
# commits its own mago.toml / .oxfmtrc wins, and no files of a kind is a loud
# pass, not a failure.
#
# The PHP baseline (/opt/civikitchen-mago/mago.toml) is tuned so its output is
# clean under the bundled phpcs standard — formatter and lint gate must never
# disagree. The JS side needs no such tuning: the ESLint baseline carries no
# style rules at all, so oxfmt cannot contradict it by construction.
#
# File selection is git ls-files, not the formatters' own discovery — mago
# finds nothing without configured source paths, and the exclusion list
# (vendored trees, minified bundles, civix/DAO generated code) belongs in one
# place, not two tool configs. Generated PHP is excluded because civix
# regenerates it verbatim: formatting it would put every `civix upgrade` in a
# fight with the format gate.
#
set -euo pipefail

# Shared plumbing: tool name, ck_die, ck_git, the extension-root check and the
# file-exclusion patterns. Resolves in a checkout and in the image alike —
# toolbelt/lib/ckcommon.sh next to toolbelt/bin, /usr/local/lib/ckcommon.sh
# next to /usr/local/bin.
# shellcheck source=../lib/ckcommon.sh
. "$(dirname "${BASH_SOURCE[0]}")/../lib/ckcommon.sh"

usage() {
  cat <<'EOF'
ckfmt — format a CiviCRM extension (mago for PHP, oxfmt for JS/TS).

  ckfmt              format in place
  ckfmt --check      report what is unformatted, exit non-zero if anything is
  ckfmt path ...     limit to the given files/dirs

A committed mago.toml or .oxfmtrc.* wins over the bundled baseline for its
half. Run from the extension root of a git checkout.
EOF
}

check=0
paths=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --check)   check=1 ;;
    -h|--help) usage; exit 0 ;;
    --)        shift; break ;;
    -*)        echo "ckfmt: unknown option: $1" >&2; usage >&2; exit 2 ;;
    *)         paths+=("$1") ;;
  esac
  shift
done
while [ "$#" -gt 0 ]; do paths+=("$1"); shift; done

ck_require_extension_root

ck_in_git_repo \
  || ck_die "not a git checkout — the file list comes from git ls-files."

# Toolchain locations: the image's /opt path first, then the toolbelt beside
# this script ($ck_root), so the tool can be developed and tested outside the
# image. Same fallback shape as cklint and ckeslint.
mago_bin=$(command -v mago || true)
[ -n "$mago_bin" ] || ck_die "no mago on PATH — is this a civikitchen image?"
mago_config=/opt/civikitchen-mago/mago.toml
[ -f "$mago_config" ] || mago_config="$ck_root/mago/mago.toml"
oxfmt_bin=/opt/civikitchen-oxfmt/node_modules/.bin/oxfmt
[ -x "$oxfmt_bin" ] || oxfmt_bin="$ck_root/oxfmt/node_modules/.bin/oxfmt"

# Committed, non-vendored, non-generated files of one kind. `|| true` on the
# filter chain: grep exits 1 when it filters everything away, and under
# pipefail that would abort on exactly the "no files" case this reports.
list_files() { # $1 = php|js
  local globs
  case "$1" in
    php) globs=('*.php') ;;
    js)  globs=('*.js' '*.mjs' '*.cjs' '*.ts' '*.tsx') ;;
  esac
  { ck_git ls-files -- "${globs[@]}" 2>/dev/null \
    | grep -Ev "$ck_re_vendored" \
    | grep -Ev "$ck_re_minified" \
    | grep -Ev "$ck_re_civix" \
    | grep -Ev "$ck_re_dao" \
    | ck_drop_repo_vendored || true; }
}

# In paths mode, git ls-files scoped to those paths keeps every exclusion
# above intact — a path argument narrows the list, it never bypasses it.
collect() { # $1 = php|js
  if [ "${#paths[@]}" -eq 0 ]; then
    list_files "$1"
  else
    comm -12 <(list_files "$1" | sort) <(ck_git ls-files -- "${paths[@]}" 2>/dev/null | sort -u)
  fi
}

rc=0

# --- PHP: mago fmt -----------------------------------------------------------
php_files=()
while IFS= read -r f; do [ -n "$f" ] && php_files+=("$f"); done < <(collect php)
if [ "${#php_files[@]}" -eq 0 ]; then
  echo "ckfmt: no PHP files to format."
else
  args=()
  # A committed mago.toml wins by ABSENCE of --config: mago then finds it in
  # the workspace itself, exactly like a project phpcs.xml.dist beats cklint's
  # bundled standard.
  if [ -f mago.toml ]; then
    echo "ckfmt: using this repo's own mago.toml (the CiviKitchen baseline does not apply)."
  else
    args+=(--config "$mago_config")
  fi
  if [ "$check" -eq 1 ]; then
    "$mago_bin" ${args[@]+"${args[@]}"} fmt --check "${php_files[@]}" || rc=1
  else
    # mago's line-breaking is not always idempotent in a single pass (observed
    # on 1.45.0: a joined multi-line condition re-splits on the next run), so
    # format until --check agrees, bounded. A tree still moving after three
    # passes is a mago bug worth failing on, not hiding.
    pass=0
    while true; do
      "$mago_bin" ${args[@]+"${args[@]}"} fmt "${php_files[@]}" || { rc=1; break; }
      "$mago_bin" ${args[@]+"${args[@]}"} fmt --check "${php_files[@]}" >/dev/null 2>&1 && break
      pass=$((pass + 1))
      [ "$pass" -lt 3 ] || { echo "ckfmt: mago output did not stabilise after 3 passes — likely a mago formatter bug." >&2; rc=1; break; }
    done
  fi
fi

# --- JS/TS: oxfmt ------------------------------------------------------------
js_files=()
while IFS= read -r f; do [ -n "$f" ] && js_files+=("$f"); done < <(collect js)
if [ "${#js_files[@]}" -eq 0 ]; then
  echo "ckfmt: no JavaScript or TypeScript to format."
else
  [ -x "$oxfmt_bin" ] || { echo "ckfmt: no oxfmt toolchain at /opt/civikitchen-oxfmt — is this a civikitchen image?" >&2; exit 2; }
  # Same rule as the PHP half: a committed .oxfmtrc.* wins by absence of -c.
  # The bundled baseline is oxfmt's own defaults (2-space, prettier-shaped),
  # stated in a file so oxfmt doesn't nag every run about a missing config.
  [ "$check" -eq 1 ] && ox_args=(--check) || ox_args=(--write)
  if compgen -G '.oxfmtrc.*' > /dev/null; then
    echo "ckfmt: using this repo's own .oxfmtrc.* (the CiviKitchen baseline does not apply)."
  else
    ox_args+=(-c "$(dirname "$oxfmt_bin")/../../oxfmtrc.json")
  fi
  "$oxfmt_bin" "${ox_args[@]}" "${js_files[@]}" || rc=1
fi

if [ "$check" -eq 1 ] && [ "$rc" -ne 0 ]; then
  echo "ckfmt: unformatted files found — run ckfmt (no flags) and commit the result." >&2
fi
exit "$rc"
