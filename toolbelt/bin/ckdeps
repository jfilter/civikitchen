#!/bin/bash
#
# ckdeps — does composer.json describe the dependencies the code actually uses?
#
# Three answers composer itself never gives: a package used but not required
# (works until someone installs without the transitive dependency that dragged
# it in), a package required but unused, and a dev dependency reached from
# production code.
#
# The bundled config teaches it that CiviCRM is not a composer dependency —
# core sits on the classloader, so CRM_*, Civi\* and civicrm_api4() are not
# findings. Without that, an extension is nothing but false positives.
#
# Extensions with no composer dependencies at all (most of them) are a PASS,
# not a failure — the analyser exits non-zero for them on its own.
#
set -uo pipefail

# Shared plumbing: tool name, ck_die, ck_git, the extension-root check and the
# file-exclusion patterns. Resolves in a checkout and in the image alike —
# toolbelt/lib/ckcommon.sh next to toolbelt/bin, /usr/local/lib/ckcommon.sh
# next to /usr/local/bin.
# shellcheck source=../lib/ckcommon.sh
. "$(dirname "${BASH_SOURCE[0]}")/../lib/ckcommon.sh"

CONFIG=/opt/civikitchen-composer-deps.php
BIN=composer-dependency-analyser

usage() {
  cat <<'EOF'
ckdeps — check composer.json against the dependencies the code really uses.

  ckdeps                 analyse this extension (bundled CiviCRM-aware config)
  ckdeps --config FILE   use another config (a repo's own wins by default)

Run from the extension root. A repo shipping composer-dependency-analyser.php
gets that config instead of the bundled one.
EOF
}

args=()
custom_config=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --config)  custom_config=1; args+=("$1" "${2:-}"); shift ;;
    -h|--help) usage; exit 0 ;;
    *)         args+=("$1") ;;
  esac
  shift
done

if [ ! -f composer.json ]; then
  echo "ckdeps: no composer.json here — run from the extension root" >&2
  exit 2
fi

# A repo's own config wins; otherwise the CiviCRM-aware default.
if [ "${custom_config}" -eq 0 ] && [ ! -f composer-dependency-analyser.php ]; then
  args+=(--config "${CONFIG}")
fi

# The analyser exits 1 for a composer.json with no `require` at all — the normal
# state of an extension that depends on core alone, and not a finding. Every
# other non-zero exit is one. A `require` with only php still gets ANALYSED
# (that is where used-but-undeclared ext-* turns up), so this must key on the
# tool's own message, not on counting the manifest.
output=$("${BIN}" "${args[@]}" 2>&1)
status=$?
printf '%s\n' "${output}"
if [ "${status}" -ne 0 ] && printf '%s' "${output}" | grep -q 'No dependencies found in'; then
  echo "ckdeps: nothing declared to analyse (extension depends on CiviCRM core only)."
  exit 0
fi
exit "${status}"
