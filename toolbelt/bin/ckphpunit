#!/bin/bash
#
# ckphpunit — run the extension's PHPUnit suite with the transaction canary
# attached.
#
# Same arguments as `phpunit`, same exit code. The only difference is that the
# run happens against a GENERATED copy of the repo's phpunit config, with
# Civi\CkTest\TransactionCanaryListener appended to the <listeners> block —
# after CiviTestListener, which is what puts the canary inside the transaction
# and its check after the rollback. See toolbelt/lib/tx-canary.php
# for what it proves and why it has to be a listener.
#
# Generated rather than template-managed for one reason: a listener added to
# template/extension/phpunit.xml.dist would be drift in every repo until each
# one ran `ckinit --update`, i.e. a gate that arrives one commit per repo
# later. This way an image bump is the whole rollout.
#
# CK_TX_CANARY=0 runs plain phpunit (escape hatch for bisecting a run the
# canary itself is suspected of disturbing).
#
set -uo pipefail

# Shared plumbing: tool name, ck_die, ck_git, the extension-root check and the
# file-exclusion patterns. Resolves in a checkout and in the image alike —
# toolbelt/lib/ckcommon.sh next to toolbelt/bin, /usr/local/lib/ckcommon.sh
# next to /usr/local/bin.
# shellcheck source=../lib/ckcommon.sh
. "$(dirname "${BASH_SOURCE[0]}")/../lib/ckcommon.sh"

ck_require_extension_root

CANARY=/usr/local/share/civikitchen/tx-canary.php

# The config the run would have used. An explicit -c/--configuration wins, the
# same precedence phpunit itself applies.
config=''
prev=''
for arg in "$@"; do
  case "$prev" in
    -c|--configuration) config="$arg" ;;
  esac
  case "$arg" in
    --configuration=*) config="${arg#--configuration=}" ;;
  esac
  prev="$arg"
done
if [ -z "$config" ]; then
  for candidate in phpunit.xml phpunit.xml.dist; do
    [ -f "$candidate" ] && { config="$candidate"; break; }
  done
fi

if [ "${CK_TX_CANARY:-1}" = 0 ] || [ -z "$config" ] || [ ! -f "$CANARY" ]; then
  [ -f "$CANARY" ] || echo "ckphpunit: no canary in this image — running plain phpunit." >&2
  exec phpunit "$@"
fi

# In a writable temp dir, NOT beside the original: under CI's uid mismatch the
# mounted repo belongs to the runner and www-data cannot write there. phpunit
# resolves paths relative to the config file, so the copy absolutizes them.
generated="$(mktemp -t ckphpunit-canary-XXXXXX.xml)"
trap 'rm -f "$generated"' EXIT

# `--` is load-bearing: a script on stdin makes php read the first bare
# argument as a FILENAME instead of as $argv[1].
php -d error_reporting=E_ALL -- "$config" "$generated" "$CANARY" <<'PHP' || exit 2
<?php
[, $src, $dst, $canary] = $argv;
$dom = new DOMDocument();
$dom->preserveWhiteSpace = FALSE;
$dom->formatOutput = TRUE;
if (!@$dom->load($src)) {
  fwrite(STDERR, "ckphpunit: cannot parse $src\n");
  exit(2);
}
$root = $dom->documentElement;

// The generated copy lives in /tmp, so every path the original resolved
// relative to its own directory has to become absolute.
$base = dirname(realpath($src));
$abs = static function (string $p) use ($base): string {
  if ($p === '' || $p[0] === '/' || str_starts_with($p, 'phar://')) {
    return $p;
  }
  return $base . '/' . $p;
};
foreach (['bootstrap', 'cacheResultFile', 'extensionsDirectory', 'cacheDirectory'] as $attr) {
  if ($root->hasAttribute($attr)) {
    $root->setAttribute($attr, $abs($root->getAttribute($attr)));
  }
}
$xpath = new DOMXPath($dom);
foreach ($xpath->query('//testsuite/directory|//testsuite/file|//testsuite/exclude'
  . '|//coverage//directory|//coverage//file|//source//directory|//source//file'
  . '|//whitelist//directory|//whitelist//file') as $node) {
  $node->nodeValue = $abs(trim($node->nodeValue));
}

$listeners = $root->getElementsByTagName('listeners')->item(0);
if ($listeners === NULL) {
  $listeners = $dom->createElement('listeners');
  $root->appendChild($listeners);
}
// Appended, never prepended: CiviTestListener must open the transaction first.
$listener = $dom->createElement('listener');
$listener->setAttribute('class', 'Civi\\CkTest\\TransactionCanaryListener');
$listener->setAttribute('file', $canary);
$listeners->appendChild($listener);
if ($dom->save($dst) === FALSE) {
  fwrite(STDERR, "ckphpunit: cannot write $dst\n");
  exit(2);
}
PHP

# Strip the caller's own -c: two of them and phpunit takes the last one.
args=()
skip=0
for arg in "$@"; do
  if [ "$skip" = 1 ]; then skip=0; continue; fi
  case "$arg" in
    -c|--configuration) skip=1; continue ;;
    --configuration=*) continue ;;
  esac
  args+=("$arg")
done

phpunit -c "$generated" ${args[@]+"${args[@]}"}
