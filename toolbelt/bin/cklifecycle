#!/bin/bash
#
# cklifecycle — install → disable → enable → uninstall → enable, with the two
# things a bare `cv ext:*` sequence cannot tell you.
#
#   1. Did uninstall actually undo the install? Exit code 0 from
#      `cv ext:uninstall` only means uninstall() did not throw. Leftover
#      tables, orphaned civicrm_managed rows, surviving option groups/values
#      and scheduled jobs all pass it. See civikitchen-lifecycle-check.php.
#
#   2. Did anything go wrong QUIETLY? An install() wrapped in try/catch that
#      swallows a "Table 'civicrm_widget' doesn't exist" leaves the run green
#      and the site broken. So every step's output plus the delta of the
#      CiviCRM ConfigAndLog files is scanned for SQL and PHP failure
#      signatures.
#
# The log gate is deliberately scoped to THIS tool and not to phpunit: a
# negative test that asserts an API call fails is supposed to log an error, and
# a gate that cannot tell the two apart is a gate people turn off.
#
# What it matches (and what it does not):
#   MATCHED   SQLSTATE[...], "DB Error", "Table '...' doesn't exist",
#             "Unknown table", "Unknown column", "Duplicate column",
#             "Syntax error or access violation",
#             PHP Fatal error / Parse error / Warning / Recoverable
#   NOT       PHP Notice, PHP Deprecated, "Deprecation" — core emits these on
#             every supported version, so they would make the gate noise; and
#             the deprecation story is already told by the phpunit config's
#             convertDeprecationsToExceptions and by phpstan.
#
# A repo with a legitimate exception declares it in .ckconform, with a reason,
# the same shape ckinit uses for template deviations:
#
#     lifecycle_log_ignore=Unknown column 'is_legacy' -- dropped in the 5.x upgrader
#
# Run from the extension root, inside a civikitchen container.
#
set -uo pipefail

# Shared plumbing: tool name, ck_die, ck_git, the extension-root check and the
# file-exclusion patterns. Resolves in a checkout and in the image alike —
# toolbelt/lib/ckcommon.sh next to toolbelt/bin, /usr/local/lib/ckcommon.sh
# next to /usr/local/bin.
# shellcheck source=../lib/ckcommon.sh
. "$(dirname "${BASH_SOURCE[0]}")/../lib/ckcommon.sh"

usage() {
  cat <<'EOF'
cklifecycle — exercise the extension lifecycle and gate on DB leftovers + logs.

  cklifecycle             run the full cycle for the extension in this directory
  cklifecycle --key KEY   override the extension key (default: from info.xml)

Sequence: disable → enable → uninstall → (DB invariant check) → enable.
Exits non-zero on a failed step, a wrong end state, a leftover, or a matched
log line. All findings are printed; the run does not stop at the first.
EOF
}

key=''
while [ "$#" -gt 0 ]; do
  case "$1" in
    --key)     shift; key="${1:-}" ;;
    -h|--help) usage; exit 0 ;;
    *)         echo "cklifecycle: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

ck_require_extension_root

info=$(tr '\n' ' ' < info.xml)
if [ -z "$key" ]; then
  key=$(echo "$info" | grep -o '<extension[^>]*key="[^"]*"' | head -1 | sed 's/.*key="//; s/"$//')
fi
# The <file> value is civix's short name, and the prefix every hand-named
# table, option group and scheduled job in the extension is built from.
prefix=$(echo "$info" | grep -o '<file>[^<]*</file>' | head -1 | sed 's/<file>//; s|</file>||')
if [ -z "$key" ] || [ -z "$prefix" ]; then
  ck_die "could not read the extension key and <file> from info.xml."
fi

extdir=$(pwd)
work=$(mktemp -d /tmp/cklifecycle-XXXXXX)
trap 'rm -rf "$work"' EXIT
transcript="$work/steps.log"
: > "$transcript"

logdir=$(cv ev 'echo CRM_Core_Config::singleton()->configAndLogDir;' 2>/dev/null | tr -d '\r')
[ -d "$logdir" ] || logdir=''

# Byte offsets before the cycle: the file already holds this site's install
# history, and only what THIS run appends is evidence.
declare -A offset_before=()
if [ -n "$logdir" ]; then
  for f in "$logdir"/*; do
    [ -f "$f" ] && offset_before["$f"]=$(wc -c < "$f")
  done
fi

failed=0

step() {
  local label="$1"; shift
  echo "cklifecycle: $label"
  local out status
  # Captured, not piped: a pipeline would hand back tee's status, and the
  # step's own exit code is half the point.
  out=$("$@" 2>&1); status=$?
  { echo "--- $label"; printf '%s\n' "$out"; } >> "$transcript"
  printf '%s\n' "$out" | sed 's/^/    /'
  if [ "$status" -ne 0 ]; then
    echo "cklifecycle: step failed: $label (exit $status)" >&2
    failed=1
  fi
}

step "disable"   cv ext:disable "$key"
step "enable"    cv ext:enable "$key"
step "uninstall" cv ext:uninstall "$key"

echo "cklifecycle: checking post-uninstall DB invariants"
if ! CK_LC_KEY="$key" CK_LC_DIR="$extdir" CK_LC_PREFIX="$prefix" \
    cv scr /usr/local/share/civikitchen/lifecycle-check.php 2>&1 | tee -a "$transcript"; then
  failed=1
fi

step "re-enable" cv ext:enable "$key"

status=$(cv ev "echo CRM_Extension_System::singleton()->getManager()->getStatus('$key');" 2>/dev/null | tr -d '[:space:]')
if [ "$status" != installed ]; then
  echo "cklifecycle: extension ended up '$status', expected 'installed'" >&2
  failed=1
fi

# --- log gate ---------------------------------------------------------------
delta="$work/logs.txt"
cp "$transcript" "$delta"
if [ -n "$logdir" ]; then
  for f in "$logdir"/*; do
    [ -f "$f" ] || continue
    start=${offset_before["$f"]:-0}
    tail -c "+$((start + 1))" "$f" >> "$delta"
  done
fi

patterns='SQLSTATE\[|DB Error|Table .[^ ]*. doesn.t exist|Unknown table|Unknown column|Duplicate column|Syntax error or access violation|PHP Fatal error|PHP Parse error|PHP Warning|PHP Recoverable'

hits=$(grep -E -n "$patterns" "$delta" 2>/dev/null)

# Declared exceptions are dropped from the hit list, not from the pattern:
# a repo should see in the summary what it chose to ignore.
#
# ck_policy_all, not sed: lifecycle_log_ignore is one of the two repeatable
# keys, so every occurrence counts, and the reason has to survive the read
# because checking that it is there is this loop's job.
ignored=''
if [ -n "$hits" ]; then
  while IFS= read -r rule; do
    [ -z "$rule" ] && continue
    case "$rule" in
      *' -- '*) ;;
      *) echo "cklifecycle: lifecycle_log_ignore needs a ' -- <reason>': $rule" >&2; failed=1; continue ;;
    esac
    pat=${rule%% -- *}
    kept=$(echo "$hits" | grep -E -v -- "$pat")
    dropped=$(echo "$hits" | grep -E -c -- "$pat")
    [ "$dropped" -gt 0 ] && ignored="${ignored}  ${dropped}x ignored by: ${rule}"$'\n'
    hits="$kept"
  done < <(ck_policy_all lifecycle_log_ignore)
fi

echo
echo "### Lifecycle gate (\`$key\`)"
echo
[ -n "$ignored" ] && { echo "Declared exceptions:"; echo; printf '%s' "$ignored"; echo; }
if [ -n "$hits" ]; then
  echo "**Failures found in the lifecycle logs** (CiviCRM ConfigAndLog + step output):"
  echo
  echo '```'
  echo "$hits" | head -100
  echo '```'
  echo
  echo "A swallowed SQL error is still a broken install. Fix the cause, or — if the line is expected —"
  echo "declare it with a reason in \`.ckconform\`: \`lifecycle_log_ignore=<regex> -- <why>\`."
  failed=1
else
  echo "No SQL or PHP failure signatures in the lifecycle logs."
fi

if [ "$failed" -ne 0 ]; then
  echo
  echo "Result: **FAILED**"
  exit 1
fi
echo
echo "Result: passed (disable → enable → uninstall → enable, extension \`installed\`)."
