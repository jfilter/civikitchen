#!/bin/bash
#
# ckmutate — mutation testing (infection) for the assertions, not the lines.
#
# ckcoverage answers "was this line executed by a test?". That is the cheap
# half of the question: a test that runs a line and asserts nothing about it
# scores the same as one that pins its behaviour. Infection changes the code
# under the suite — flips a comparison, drops a return, empties a body — and
# reports how many of those mutants a test noticed. A surviving mutant is a
# line the suite covers but does not check.
#
# NOT a push gate, by design. A mutation run costs one full suite per mutant
# batch and its score moves with unrelated refactors, so wiring it into every
# push would buy a slow, flappy build. It belongs in the scheduled workflow
# (`mutation: true` in the compat caller) — see docs/extension-standards.md.
#
# Like every other threshold in this fleet, the floor is POLICY and lives in
# the consuming repo:
#
#     # .ckconform
#     mutation_min_msi=60          # --min-msi: mutants killed, all mutants
#     mutation_min_covered_msi=75  # optional, --min-covered-msi: covered code only
#     mutation_paths=Civi          # optional, what to mutate (comma-separated)
#
# Without mutation_min_msi this tool is a NO-OP that exits 0 and says so. That
# is deliberate: a repo has to measure its own score before it can pick a floor,
# and a fleet-wide default floor would only teach people to ignore a red
# scheduled build.
#
# Two modes, chosen by mutation_paths:
#   set    — mutate exactly those paths, whole files. What a scheduled run
#            wants: point it at the domain logic and the exporters, not at the
#            generated glue where a surviving mutant means nothing.
#   unset  — `--git-diff-lines` against CK_MUTATE_BASE (default origin/main):
#            only the lines this branch touched. Fast, and the honest question
#            for a change under review.
#
set -uo pipefail

# Shared plumbing: tool name, ck_die, ck_git, the extension-root check and the
# file-exclusion patterns. Resolves in a checkout and in the image alike —
# toolbelt/lib/ckcommon.sh next to toolbelt/bin, /usr/local/lib/ckcommon.sh
# next to /usr/local/bin.
# shellcheck source=../lib/ckcommon.sh
. "$(dirname "${BASH_SOURCE[0]}")/../lib/ckcommon.sh"

ck_require_extension_root

read_key() {
  [ -f .ckconform ] || return 0
  sed -n "s/^$1=//p" .ckconform | head -1 | tr -d ' \t'
}

floor=$(read_key mutation_min_msi)
if [ -z "$floor" ]; then
  echo "ckmutate: no mutation_min_msi in .ckconform — nothing to enforce, skipping."
  echo "ckmutate: to adopt this, measure once (ckmutate runs with any floor, e.g. mutation_min_msi=1), then set the floor to what you have."
  exit 0
fi

command -v infection >/dev/null 2>&1 || {
  echo "ckmutate: infection is not installed in this image — a scheduled job on an older image tag should pin a newer one." >&2
  exit 2
}

if [ ! -f phpunit.xml.dist ] && [ ! -f phpunit.xml ]; then
  echo "ckmutate: no phpunit config — mutation testing needs a suite to run against." >&2
  exit 2
fi

# Infection needs line coverage to know which mutants a test even reaches; with
# no driver it would report every mutant as "not covered" and the score is junk.
php -m | grep -qiE '^(pcov|xdebug)$' || {
  echo "ckmutate: no pcov/xdebug loaded — infection cannot collect coverage." >&2
  exit 2
}

covered_floor=$(read_key mutation_min_covered_msi)
paths=$(read_key mutation_paths)

# Source dirs for the config: the configured paths, or the conventional
# extension roots that exist here.
if [ -n "$paths" ]; then
  IFS=',' read -r -a dirs <<< "$paths"
else
  dirs=()
  for d in Civi CRM src; do [ -d "$d" ] && dirs+=("$d"); done
fi
[ "${#dirs[@]}" -gt 0 ] || { echo "ckmutate: no source directory to mutate (looked for Civi/, CRM/, src/ — or set mutation_paths in .ckconform)." >&2; exit 2; }
for d in "${dirs[@]}"; do
  [ -e "$d" ] || { echo "ckmutate: mutation_paths names '$d', which does not exist here." >&2; exit 2; }
done

# The config lives in the extension root, not in /tmp: infection resolves the
# phpunit config and the source dirs relative to the config file's directory.
config=.ckmutate.json
[ -e "$config" ] && { echo "ckmutate: $config already exists — refusing to overwrite it." >&2; exit 2; }
tmpdir=$(mktemp -d /tmp/ckmutate-run-XXXXXX)
trap 'rm -rf "$config" "$tmpdir"' EXIT

# Generated rather than committed per repo: the only repo-specific parts are
# the paths, and those are already in .ckconform.
php -r '
  $dirs = array_slice($argv, 2);
  $conf = [
    "\$schema" => "vendor/infection/infection/resources/schema.json",
    "source" => ["directories" => $dirs],
    "tmpDir" => $argv[1],
    "logs" => ["text" => "php://stdout"],
    "phpUnit" => ["customPath" => trim(shell_exec("command -v phpunit")) ?: "phpunit"],
    "testFramework" => "phpunit",
  ];
  echo json_encode($conf, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);
' "$tmpdir" "${dirs[@]}" > "$config"

args=(--configuration="$config" --no-progress --no-interaction --min-msi="$floor")
[ -n "$covered_floor" ] && args+=(--min-covered-msi="$covered_floor")

if [ -n "$paths" ]; then
  echo "ckmutate: mutating ${dirs[*]} (mutation_paths), floor ${floor}% MSI."
else
  base="${CK_MUTATE_BASE:-origin/main}"
  git rev-parse --verify --quiet "$base" >/dev/null || {
    echo "ckmutate: CK_MUTATE_BASE '$base' is not a resolvable ref — a shallow checkout needs fetch-depth: 0, or set mutation_paths." >&2
    exit 2
  }
  echo "ckmutate: mutating the lines changed against ${base}, floor ${floor}% MSI."
  args+=(--git-diff-lines --git-diff-base="$base")
fi

CIVICRM_UF=${CIVICRM_UF:-UnitTests} infection "${args[@]}" "$@"
status=$?

if [ "$status" -eq 0 ]; then
  echo "ckmutate: floor met."
else
  echo "ckmutate: FAIL — the score is below the floor from .ckconform, or the run itself broke (exit ${status})." >&2
  echo "ckmutate: a surviving mutant is a line the suite EXECUTES but does not assert on — add the assertion, do not lower the floor." >&2
fi
exit "$status"
