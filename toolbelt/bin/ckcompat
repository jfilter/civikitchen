#!/bin/bash
#
# ckcompat — does this extension actually RUN on the PHP floor it declares?
#
# The floor is a promise made in composer.json (require.php) and repeated in
# info.xml. Two other tools check the promise is CONSISTENT (ckconform) and
# that types hold under it (phpstan's phpVersion). Neither knows that
# json_validate() arrived in 8.3: that is what the PHPCompatibility standard is
# for, and this runs it against the floor the repo itself declares.
#
# Two stages, because they answer the question differently:
#   1. mago --semantics at the floor version — a real PARSE at the floor. Any
#      syntax the floor cannot read is a fatal on install, and this is
#      categorical: it needs no sniff to have been written for the construct.
#      The image has exactly one PHP (8.4), so `php -l` here is blind to
#      8.4-only syntax — mago's parser takes a target version, php's does not.
#   2. PHPCompatibility — everything a parse cannot see: functions, constants,
#      ini settings and behaviour that moved between versions.
#
# Pairs with cklint (style) and ckconform (repo structure).
#
set -euo pipefail

# Shared plumbing: tool name, ck_die, ck_git, the extension-root check and the
# file-exclusion patterns. Resolves in a checkout and in the image alike —
# toolbelt/lib/ckcommon.sh next to toolbelt/bin, /usr/local/lib/ckcommon.sh
# next to /usr/local/bin.
# shellcheck source=../lib/ckcommon.sh
. "$(dirname "${BASH_SOURCE[0]}")/../lib/ckcommon.sh"

usage() {
  cat <<'EOF'
ckcompat — check PHP cross-version compatibility against the declared floor.

  ckcompat                 check the project (composer.json require.php floor)
  ckcompat path ...        check the given files/dirs
  ckcompat --php 8.1       check against this floor instead of composer's
  ckcompat --range 8.1-8.4 check a closed range (default is "<floor>-", open)

Run from the extension root. The floor comes from composer.json require.php;
ckconform keeps that value and info.xml's <php_compatibility> in step.
EOF
}

test_version=""
paths=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --php)     shift; test_version="${1:-}-" ;;
    --php=*)   test_version="${1#--php=}-" ;;
    --range)   shift; test_version="${1:-}" ;;
    --range=*) test_version="${1#--range=}" ;;
    -h|--help) usage; exit 0 ;;
    --)        shift; break ;;
    -*)        echo "ckcompat: unknown option: $1" >&2; usage >&2; exit 2 ;;
    *)         paths+=("$1") ;;
  esac
  shift
done
while [ "$#" -gt 0 ]; do paths+=("$1"); shift; done

# The floor composer promises to install on, as MAJOR.MINOR.
if [ -z "${test_version}" ]; then
  floor=$(php -r '$c = @file_get_contents("composer.json");
    $v = $c === FALSE ? NULL : (json_decode($c, TRUE)["require"]["php"] ?? NULL);
    echo is_string($v) && preg_match("/(\d+)\.(\d+)/", $v, $m) ? $m[0] : "";' 2>/dev/null || true)
  if [ -z "${floor}" ]; then
    echo "ckcompat: no PHP floor in composer.json require.php — declare one, or pass --php" >&2
    exit 2
  fi
  test_version="${floor}-"
fi

# Default scope: the extension's own PHP, not generated or vendored code.
if [ "${#paths[@]}" -eq 0 ]; then
  for d in Civi CRM api managed; do [ -d "$d" ] && paths+=("$d"); done
  while IFS= read -r f; do [ -n "$f" ] && paths+=("$f"); done \
    < <(find . -maxdepth 1 -name '*.php' -type f 2>/dev/null)
  [ "${#paths[@]}" -eq 0 ] && paths=(".")
fi

echo "ckcompat: PHP ${test_version} (from composer.json unless overridden)"
rc=0

# --- stage 1: does the floor's parser even accept this code? -----------------
# `--php-version` overrides mago.toml and the environment, so the floor wins
# over a repo baseline pinned to something else. `--semantics` runs no lint
# rules, so a committed mago.toml changes nothing here.
floor_version="${test_version%%-*}"
mago_bin=$(command -v mago || true)
# mago's parser starts at 8.0 and refuses to run below it. The fleet floor is
# 8.1, so this only fires for a legacy repo — and there stage 2 alone is still
# a better answer than an abort nobody can read.
case "${floor_version}" in
  [0-7].*) mago_bin="" ;;
esac
if [ -z "${mago_bin}" ]; then
  echo "ckcompat: no usable mago for PHP ${floor_version} — floor parse check skipped" >&2
else
  mago_files=()
  while IFS= read -r f; do [ -n "${f}" ] && mago_files+=("${f}"); done < <(
    find "${paths[@]}" -type f -name '*.php' 2>/dev/null \
      | grep -Ev '(^|/)(vendor|node_modules|\.civikitchen-siblings)/' \
      | grep -Ev '\.civix\.php$' \
      | grep -Ev "$ck_re_dao" || true
  )
  if [ "${#mago_files[@]}" -eq 0 ]; then
    echo "ckcompat: no PHP files for the floor parse check."
  else
    "${mago_bin}" --php-version "${floor_version}" lint --semantics \
      "${mago_files[@]}" || rc=1
  fi
fi

# --- stage 2: version-specific APIs and behaviour ----------------------------
phpcs -q \
  --standard=PHPCompatibility \
  --runtime-set testVersion "${test_version}" \
  --extensions=php \
  --ignore='*/vendor/*,*/node_modules/*,*.civix.php,*/CRM/*/DAO/*,*/.civikitchen-siblings/*' \
  "${paths[@]}" || rc=1

exit "${rc}"
