<?xml version="1.0"?>
<ruleset name="CiviKitchen">
  <description>
    Opinionated phpcs standard for CiviCRM extensions, shipped in the
    civikitchen image. It is CiviCRM's Drupal base MINUS the doc-comment
    sniffs that fight modern PHPStan array-shape / generic PHPDocs (which
    PHPStan validates far more precisely), MINUS the two layout checks the
    bundled formatter contradicts (ckfmt owns layout).

    CiviKitchen's own checks (bare ts(), standard-hook mixins, the @required
    trap, file length, positional booleans, unserialize, tautological
    assertions, declare(strict_types)) are mago extension rules, run by
    cklint's mago stage from /opt/civikitchen/toolbelt/mago/mago.toml.

    Use it directly (`phpcs --standard=CiviKitchen` / `cklint`) or reference
    it from a project phpcs.xml.dist (`<rule ref="CiviKitchen"/>`) and add
    project-specific paths, config and sniffs on top — the per-extension layer
    is always yours.
  </description>

  <!-- PHP only, everywhere: a bare `phpcbf` run with this standard must never
       rewrite markdown/CSS/JS (it has mangled code fences in docs before),
       and generated/vendored code is not ours to style. Project rulesets can
       widen this, but the safe default lives here. -->
  <arg name="extensions" value="php"/>

  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/dist/*</exclude-pattern>
  <exclude-pattern>*.civix.php</exclude-pattern>
  <exclude-pattern>*/CRM/*/DAO/*</exclude-pattern>

  <rule ref="Drupal">
    <!-- Deprecated CSS/MySource sniffs (removed in phpcs 4.0) — pointless
         under the PHP-only scope above and noisy at registration time. -->
    <exclude name="Squiz.CSS"/>
    <exclude name="MySource.Debug.DebugCode"/>
    <exclude name="Drupal.Commenting.FunctionComment"/>
    <exclude name="Drupal.Commenting.VariableComment"/>
    <exclude name="Drupal.Commenting.HookComment"/>
    <exclude name="Drupal.Commenting.DataTypeNamespace"/>
    <!-- ckfmt wraps long `implements` lists with a 2-space continuation, this
         sniff wants 4. The formatter owns layout; one gate must yield. -->
    <exclude name="Drupal.Classes.ClassDeclaration.InterfaceWrongIndent"/>
    <!-- Same sniff, the overlong-declaration cases: ckfmt breaks after
         `extends` and indents the parent name, which this sniff reads as
         "3 spaces before the name" and, when an `implements` list follows,
         as "implements not on the class-name line". -->
    <exclude name="Drupal.Classes.ClassDeclaration.SpaceBeforeName"/>
    <exclude name="Drupal.Classes.ClassDeclaration.ImplementsLine"/>
  </rule>

  <!-- An `echo` whose concatenation exceeds the print width: ckfmt breaks
       after the keyword and leaves the semicolon on its own line. Both sniffs
       are pure layout, which the formatter owns; SemicolonSpacing carries a
       single message code, so excluding it retires that sniff. -->
  <rule ref="Squiz.WhiteSpace.LanguageConstructSpacing">
    <exclude name="Squiz.WhiteSpace.LanguageConstructSpacing.IncorrectSingle"/>
  </rule>
  <rule ref="Squiz.WhiteSpace.SemicolonSpacing">
    <exclude name="Squiz.WhiteSpace.SemicolonSpacing.Incorrect"/>
  </rule>

  <!-- An array literal whose first element is itself an array literal: ckfmt
       keeps `[[` / `]]` on shared lines, this sniff wants the closing bracket
       alone on its line. Bracket placement belongs to the formatter.
       IndexNoNewline is the same disagreement from the opening side: ckfmt
       writes `['key' => [` and the sniff wants `'key'` on its own line. Both
       messages the code carries ("first index", "each index") are pure layout,
       so a repo that runs ckfmt cannot satisfy the sniff at all. -->
  <rule ref="Squiz.Arrays.ArrayDeclaration">
    <exclude name="Squiz.Arrays.ArrayDeclaration.CloseBraceNewLine"/>
    <exclude name="Squiz.Arrays.ArrayDeclaration.IndexNoNewline"/>
  </rule>

  <!-- An array value that ckfmt wraps — a long concatenation, say — gets the
       formatter's continuation indent, which this sniff measures against the
       array element it belongs to and rejects. Demonstrably unsatisfiable:
       phpcbf reindents, the next ckfmt puts it back, and the pair oscillates.
       Every other Drupal.Arrays check stays on; only the indent yields. -->
  <rule ref="Drupal.Arrays.Array">
    <exclude name="Drupal.Arrays.Array.ArrayIndentation"/>
  </rule>

  <!-- The same wrapped value seen from the scope tracker: after ckfmt's
       continuation indent this sniff measures every following sibling key
       one level too deep, and phpcbf reindents what the next ckfmt undoes.
       Indentation is the formatter's — ckfmt rewrites a wrong indent on the
       same file set this standard covers, so nothing goes unchecked. -->
  <rule ref="Drupal.WhiteSpace.ScopeIndent">
    <exclude name="Drupal.WhiteSpace.ScopeIndent.IncorrectExact"/>
  </rule>

  <!-- The test bootstrap's `if (!function_exists('cv')) { function cv() {…} }`
       idiom: ckfmt strips the blank lines at the block edges, this sniff wants
       them. Scoped to that one file, not disabled fleet-wide. -->
  <rule ref="Squiz.WhiteSpace.FunctionSpacing">
    <exclude-pattern>*/tests/phpunit/bootstrap.php</exclude-pattern>
  </rule>

  <!-- Commented-out code (dead civix example blocks are an audit regular).
       Threshold raised from the default 35% to cut prose false positives. -->
  <rule ref="Squiz.PHP.CommentedOutCode">
    <properties>
      <property name="maxPercentage" value="60"/>
    </properties>
  </rule>
</ruleset>
