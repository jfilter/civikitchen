{
    "name": "civikitchen/phpstan-root",
    "description": "CiviKitchen phpstan installation root: the pinned phpstan engine plus the extensions every image ships. The CiviKitchen extension itself lives in toolbelt/phpstan and joins as a path repository at build time.",
    "license": "AGPL-3.0-or-later",
    "require": {
        "phpat/phpat": "0.12.4",
        "phpstan/extension-installer": "1.4.3",
        "phpstan/phpstan": "2.2.3",
        "phpstan/phpstan-deprecation-rules": "2.0.5",
        "phpstan/phpstan-phpunit": "2.0.18",
        "phpstan/phpstan-strict-rules": "2.0.12",
        "spaze/phpstan-disallowed-calls": "v4.14.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.1.31"
        }
    },
    "extra": {
        "phpstan/extension-installer": {
            "ignore": [
                "phpstan/phpstan-strict-rules"
            ]
        }
    }
}
