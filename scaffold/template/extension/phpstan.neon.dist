includes:
	# The CiviCRM call bans (APIv3 entry points, CRM_Utils_Array::value, …) as
	# spaze/phpstan-disallowed-calls config — shipped in the civikitchen image,
	# which is also the only place a phpstan binary exists.
	- /opt/civikitchen-phpstan-config/civicrm-disallowed.neon
	# Opt in when the repo is ready; it is loud on older code:
	# - /opt/civikitchen-phpstan/vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
	level: 10
	# Analyse for the floor composer.json promises, not for whatever PHP the
	# image runs — keep the two in step (ckconform: php-version-coherence).
	phpVersion: 80100
	# PHPDoc array shapes (APIv4 rows, decoded JSON) describe what the data
	# IS, but defensive runtime checks (is_array on decoded JSON) must not be
	# reported as redundant because of them. Also: PEAR-era signatures lie in
	# their PHPDocs (a documented "array" can be a PEAR_Error).
	treatPhpDocTypesAsCertain: false
	# Not implied by any level. A typed property with no default is a runtime
	# Error waiting for the one path that reads it before writing it; APIv4
	# action parameters are exempted by the package's properties extension.
	checkUninitializedProperties: true
	paths:
		- Civi
		- CRM
		- managed
		- __EXTKEY__.php
	excludePaths:
		analyse:
			# civix-generated stubs; the DAO base class is created at runtime
			- CRM/*/DAO/*
			- CRM/*/BAO/*
	scanFiles:
		- __EXTKEY__.civix.php
	# scanDirectories:
	#	# Core component extensions live off the classloader path — add the
	#	# ones whose types you touch (extensions in info.xml <requires> are
	#	# autoloaded by phpstanBootstrap.php already), e.g.:
	#	# - /var/www/html/core/ext/civi_mail
	#	# - /var/www/html/core/ext/flexmailer/src
	bootstrapFiles:
		- phpstanBootstrap.php
	civikitchen:
		# ck.sql.unknownTable checks `civicrm_`-prefixed table names in raw SQL
		# against core's schema plus this repo's own (schema/, xml/schema/,
		# sql/). List here the `civicrm_`-prefixed tables of OTHER extensions
		# this repo queries — they exist on the site but in no catalog:
		#	- civicrm_someext_thing
		sqlKnownTables: []
		# Report `protected ?string $x;` on an APIv4 action — nullable, no
		# default, so uninitialized until the kernel fills it
		# (ck.api4.nullableActionParamWithoutDefault). Off by default; the
		# fix is writing `= null`.
		# strictActionParams: true
	# ignoreErrors: only ever narrowly scoped (identifier + path + count) and
	# carrying a comment that says WHY the report is wrong — never blanket
	# patterns, never a baseline file. A boundary report
	# (phpat.testOnlyCoreAndOwnCivicrmDependencies) on an extension this one
	# <requires> means its checkout was not found beside this repo — mount
	# it (sibling_repo in CI); it is not an ignoreErrors case.
